@import "tailwindcss";

@theme {
  --font-sans: "Sora", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, "SF Mono", monospace;

  --color-fg: #f3f4f7;
  --color-fg-secondary: rgba(243, 244, 247, 0.72);
  --color-fg-tertiary: rgba(243, 244, 247, 0.46);
  --color-accent: #0a84ff;
  --color-ember: #ff9f0a;
  --color-ember-deep: #ff453a;
  --color-ok: #30d158;
  --color-danger: #ff453a;
  --color-glass: rgba(255, 255, 255, 0.14);
  --color-glass-heavy: rgba(18, 20, 28, 0.55);
  --color-stroke: rgba(255, 255, 255, 0.28);
  --color-stroke-soft: rgba(255, 255, 255, 0.14);

  --radius-xs: 8px;
  --radius-sm: 12px;
  --radius-md: 16px;
  --radius-lg: 22px;
  --radius-xl: 32px;
  --radius-window: 34px;
  --radius-ornament: 999px;

  --shadow-window:
    0 30px 80px rgba(0, 0, 0, 0.38),
    0 8px 24px rgba(0, 0, 0, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.38),
    inset 0 -1px 0 rgba(255, 255, 255, 0.06);
  --shadow-ornament:
    0 10px 28px rgba(0, 0, 0, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.32);
  --shadow-card:
    0 10px 30px rgba(0, 0, 0, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.28);

  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --motion-quick: 150ms;
  --motion-fast: 250ms;
  --motion-slow: 420ms;
}

@layer base {
  html,
  body,
  #app {
    height: 100%;
  }

  html {
    color-scheme: dark;
  }

  body {
    margin: 0;
    background: #12141a;
    color: var(--color-fg);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }

  button:not(:disabled),
  [role="button"]:not(:disabled) {
    cursor: pointer;
  }

  * {
    box-sizing: border-box;
  }

  ::selection {
    background: color-mix(in oklab, var(--color-accent) 45%, transparent);
  }
}

.app-root {
  position: relative;
  height: 100%;
  width: 100%;
  overflow: hidden;
}

/* ---------- Environment ---------- */

.env-root {
  position: fixed;
  inset: 0;
  overflow: hidden;
  background: #0c0e12;
}

.env-layer {
  position: absolute;
  inset: 0;
  will-change: opacity;
}

.env-layer.entering {
  opacity: 1;
  animation: env-in 1.15s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.env-layer.leaving {
  opacity: 0;
  transition: opacity 1.15s cubic-bezier(0.22, 1, 0.36, 1);
  z-index: 0;
}

.env-photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transform: none;
}

.env-veil {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 2;
  background:
    radial-gradient(120% 80% at 50% 100%, rgba(8, 10, 16, 0.38), transparent 58%),
    radial-gradient(80% 50% at 50% 0%, rgba(8, 10, 16, 0.12), transparent 52%);
}

.env-grain {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
  opacity: 0.055;
  mix-blend-mode: overlay;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.55'/></svg>");
}

.env-aurora {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  mix-blend-mode: screen;
  opacity: 0.22;
  background:
    radial-gradient(40% 30% at 30% 20%, rgba(80, 220, 160, 0.4), transparent 70%),
    radial-gradient(35% 28% at 70% 30%, rgba(80, 140, 255, 0.3), transparent 70%),
    radial-gradient(30% 24% at 50% 10%, rgba(180, 120, 255, 0.16), transparent 70%);
  animation: aurora 18s ease-in-out infinite alternate;
}

.env-dim {
  position: absolute;
  inset: 0;
  z-index: 4;
  pointer-events: none;
  background: rgba(6, 8, 12, 0.28);
  backdrop-filter: blur(14px) saturate(120%);
  opacity: 0;
  transition: opacity 420ms cubic-bezier(0.22, 1, 0.36, 1);
}

.env-dim.on {
  opacity: 1;
}

.env-send-blur {
  position: absolute;
  inset: 0;
  z-index: 5;
  pointer-events: none;
  backdrop-filter: blur(22px) saturate(140%);
  background: rgba(10, 12, 18, 0.18);
  opacity: 0;
  transition: opacity 280ms cubic-bezier(0.22, 1, 0.36, 1);
}

.env-send-blur.on {
  opacity: 1;
}

@keyframes env-in {
  from {
    opacity: 0;
    filter: blur(12px);
  }
  to {
    opacity: 1;
    filter: blur(0);
  }
}

@keyframes ken {
  from {
    transform: scale(1.05) translate3d(-1.1%, 0, 0);
  }
  to {
    transform: scale(1.14) translate3d(1.3%, -0.8%, 0);
  }
}

@keyframes ken-soft {
  from {
    transform: scale(1.03) translate3d(-0.4%, 0, 0);
  }
  to {
    transform: scale(1.08) translate3d(0.5%, -0.3%, 0);
  }
}

@keyframes tide {
  from {
    transform: scale(1.06) translate3d(0, 1.1%, 0);
  }
  to {
    transform: scale(1.12) translate3d(0, -1.5%, 0);
  }
}

@keyframes aurora {
  from {
    opacity: 0.14;
    transform: translate3d(-2%, 0, 0);
  }
  to {
    opacity: 0.32;
    transform: translate3d(3%, 1%, 0);
  }
}

/* ---------- Glass materials ---------- */

.glass-window {
  position: relative;
  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.07) 0%,
      rgba(14, 16, 22, 0.22) 48%,
      rgba(8, 10, 16, 0.3) 100%
    );
  backdrop-filter: blur(22px) saturate(150%);
  -webkit-backdrop-filter: blur(22px) saturate(150%);
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: var(--radius-window);
  box-shadow: var(--shadow-window);
  overflow: visible;
  transition:
    background 420ms cubic-bezier(0.22, 1, 0.36, 1),
    backdrop-filter 420ms cubic-bezier(0.22, 1, 0.36, 1);
}

.glass-window::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.16) 0%,
    transparent 16%
  );
  mix-blend-mode: overlay;
}

.glass-heavy {
  background:
    linear-gradient(
      180deg,
      rgba(18, 20, 28, 0.62) 0%,
      rgba(10, 12, 18, 0.72) 100%
    );
  backdrop-filter: blur(36px) saturate(150%);
  -webkit-backdrop-filter: blur(36px) saturate(150%);
  border: 1px solid rgba(255, 255, 255, 0.18);
}

.glass-ornament {
  background: rgba(22, 24, 32, 0.55);
  backdrop-filter: blur(32px) saturate(180%);
  -webkit-backdrop-filter: blur(32px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.32);
  box-shadow:
    0 16px 40px rgba(0, 0, 0, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.32);
}

.glass-thin {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(24px) saturate(170%);
  -webkit-backdrop-filter: blur(24px) saturate(170%);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.glass-card {
  background: rgba(12, 14, 20, 0.28);
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  border: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: var(--shadow-card);
  border-radius: 22px;
}

/* ---------- Scene layout ---------- */

.scene {
  position: relative;
  z-index: 1;
  height: 100%;
  width: 100%;
  display: grid;
  place-items: center;
  padding: 18px 18px 96px;
}

.stage {
  position: relative;
  width: min(390px, calc(100vw - 24px), calc((100dvh - 108px) * 9 / 19.5));
  height: min(844px, calc(100dvh - 108px));
  aspect-ratio: 9 / 19.5;
  max-height: calc(100dvh - 108px);
  display: flex;
  align-items: stretch;
  justify-content: center;
}

.main-window {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.window-body {
  position: relative;
  flex: 1;
  min-height: 0;
  padding: 14px 10px 22px;
  overflow: hidden;
  border-radius: inherit;
}

.close-affordance {
  position: absolute;
  top: -18px;
  left: 18px;
  z-index: 16;
  pointer-events: auto;
  width: 14px;
  height: 14px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.55);
  border: 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  display: grid;
  place-items: center;
  color: transparent;
  transition:
    width var(--motion-fast) var(--ease-out),
    height var(--motion-fast) var(--ease-out),
    background var(--motion-quick) var(--ease-out),
    color var(--motion-quick) var(--ease-out);
}

.close-affordance:hover,
.close-affordance:focus-visible {
  width: 22px;
  height: 22px;
  background: rgba(255, 255, 255, 0.92);
  color: #1a1a1e;
}

.window-bar {
  position: absolute;
  left: 50%;
  bottom: -22px;
  transform: translateX(-50%);
  width: 120px;
  height: 8px;
  border-radius: 999px;
  z-index: 5;
}

.leading-ornament {
  position: absolute;
  left: -58px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 8;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 8px 6px;
  border-radius: 28px;
  width: 52px;
  transition:
    width var(--motion-fast) var(--ease-out),
    padding var(--motion-fast) var(--ease-out);
}

.leading-ornament:hover,
.leading-ornament:focus-within,
.leading-ornament.expanded {
  width: 132px;
  padding: 8px 8px;
}

.tab-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  height: 40px;
  border: 0;
  background: transparent;
  color: var(--color-fg);
  border-radius: 14px;
  padding: 0 8px;
  overflow: hidden;
  white-space: nowrap;
}

.tab-btn:hover,
.tab-btn.active {
  background: rgba(255, 255, 255, 0.18);
}

.tab-btn .label {
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.01em;
  opacity: 0;
  transform: translateX(-6px);
  transition:
    opacity var(--motion-fast) var(--ease-out),
    transform var(--motion-fast) var(--ease-out);
}

.leading-ornament:hover .label,
.leading-ornament:focus-within .label,
.leading-ornament.expanded .label {
  opacity: 1;
  transform: none;
}

.dock {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 18px;
  z-index: 12;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  pointer-events: none;
  padding: 0 18px;
}

.dock > * {
  pointer-events: auto;
}

.settings-orb {
  position: absolute;
  right: 18px;
  left: auto;
  bottom: 0;
  width: 44px;
  height: 44px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  color: var(--color-fg);
  border: 0;
}

.prompt-orb {
  width: 58px;
  height: 58px;
  border-radius: 999px;
  border: 0;
  position: relative;
  background: transparent;
  padding: 0;
}

.orb-sphere {
  width: 58px;
  height: 58px;
  border-radius: 999px;
  background:
    radial-gradient(circle at 32% 28%, rgba(255, 255, 255, 0.95) 0%, rgba(190, 214, 255, 0.55) 26%, rgba(90, 130, 190, 0.5) 58%, rgba(18, 28, 48, 0.92) 100%);
  box-shadow:
    0 10px 28px rgba(0, 0, 0, 0.4),
    0 0 28px rgba(100, 170, 255, 0.28),
    inset 0 -10px 16px rgba(0, 0, 0, 0.28),
    inset 0 8px 14px rgba(255, 255, 255, 0.35);
  animation: floaty 4.6s ease-in-out infinite;
}

.prompt-orb:hover .orb-sphere {
  transform: scale(1.04);
}

@keyframes floaty {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-4px);
  }
}

.prompt-bar {
  position: absolute;
  left: 50%;
  bottom: 22px;
  transform: translateX(-50%) translateY(18px);
  width: min(392px, calc(100% - 28px));
  height: 56px;
  max-height: 56px;
  z-index: 14;
  border-radius: 28px;
  padding: 8px 8px 8px 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  opacity: 0;
  pointer-events: none;
  flex: 0 0 auto;
  transition:
    opacity var(--motion-fast) var(--ease-out),
    transform var(--motion-fast) var(--ease-out);
}

.prompt-bar.open {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}

.prompt-bar input {
  flex: 1;
  background: transparent;
  border: 0;
  outline: none;
  color: var(--color-fg);
  font: 400 15px/1.4 var(--font-sans);
  min-width: 0;
}

.prompt-bar input::placeholder {
  color: var(--color-fg-tertiary);
}

.send-btn {
  width: 40px;
  height: 40px;
  border-radius: 999px;
  border: 0;
  background: var(--color-accent);
  color: white;
  display: grid;
  place-items: center;
}

.settings-pane {
  position: absolute;
  z-index: 20;
  width: 248px;
  border-radius: 26px;
  padding: 10px;
  left: 16px;
  bottom: 72px;
  align-self: flex-start;
  height: auto;
  max-height: min(420px, 62vh);
  overflow: auto;
}

.settings-pane.models {
  width: 292px;
}

.pane-tabs {
  display: flex;
  gap: 4px;
  padding: 3px;
  border-radius: 999px;
  margin-bottom: 10px;
}

.pane-tab {
  flex: 1;
  height: 30px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--color-fg-secondary);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.pane-tab.active {
  background: rgba(255, 255, 255, 0.2);
  color: var(--color-fg);
}

.ember-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 8px 10px;
  border-radius: 14px;
  overflow: hidden;
}

.ember-row.on::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(
    120% 120% at 90% 50%,
    rgba(255, 159, 10, 0.38),
    rgba(255, 69, 58, 0.08) 42%,
    transparent 70%
  );
  pointer-events: none;
  animation: ember-breathe 2.4s ease-in-out infinite;
}

.ember-row.off::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(
    80% 80% at 90% 50%,
    rgba(255, 159, 10, 0.28),
    transparent 70%
  );
  pointer-events: none;
  animation: ember-die 0.7s var(--ease-out) both;
}

@keyframes ember-breathe {
  0%,
  100% {
    opacity: 0.7;
  }
  50% {
    opacity: 1;
  }
}

@keyframes ember-die {
  from {
    opacity: 1;
    filter: blur(0);
  }
  to {
    opacity: 0;
    filter: blur(8px);
  }
}

.lock-veil {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
}

.lock-veil.locked {
  outline: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(0, 0, 0, 0.15);
}

.lock-veil.locked::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(8, 10, 16, 0.2), rgba(8, 10, 16, 0.55));
  backdrop-filter: blur(8px);
  pointer-events: none;
}

.card-canvas {
  position: relative;
  width: 100%;
  height: 100%;
  max-width: 100%;
  min-width: 0;
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: none;
}
.card-canvas::-webkit-scrollbar { display: none; }
.card-canvas.rearranging { overflow: visible; }

.card-strip {
  position: relative;
  height: 100%;
}

.card-slot {
  position: absolute;
  top: 0;
  left: 0;
  min-height: 0;
  min-width: 0;
  touch-action: none;
}

.model-card {
  position: relative;
  width: 100%;
  height: 100%;
  padding: 10px 9px 10px;
  display: flex;
  flex-direction: column;
  border-radius: 18px;
  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.2) 0%,
      rgba(255, 255, 255, 0.06) 38%,
      rgba(0, 0, 0, 0.18) 100%
    );
  border: 1px solid rgba(255, 255, 255, 0.34);
  box-shadow:
    0 22px 44px rgba(0, 0, 0, 0.4),
    0 1px 0 rgba(255, 255, 255, 0.42) inset;
  transition:
    transform var(--motion-fast) var(--ease-out),
    box-shadow var(--motion-fast) var(--ease-out),
    filter var(--motion-fast) var(--ease-out);
  user-select: none;
  touch-action: none;
  overflow: hidden;
}

.model-card.lifted {
  z-index: 5;
  overflow: visible;
  transform: translateY(-5px) scale(1.02);
  box-shadow:
    0 14px 28px rgba(0, 0, 0, 0.4),
    0 0 0 1px rgba(255, 255, 255, 0.32),
    0 0 18px color-mix(in srgb, var(--card-accent, #fff) 28%, transparent);
}

.phone-island {
  width: 36%;
  height: 5px;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.45);
  margin: 0 auto 6px;
  flex-shrink: 0;
}

.phone-home {
  width: 34%;
  height: 3px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.32);
  margin: 6px auto 0;
  flex-shrink: 0;
}



.model-card:hover:not(.lifted) {
  transform: scale(1.015);
}

.music-widget {
  position: fixed;
  z-index: 18;
  width: 210px;
  border-radius: 22px;
  padding: 10px;
  right: 18px;
  bottom: 18px;
}

.guide-tag {
  position: absolute;
  z-index: 40;
  pointer-events: none;
  font-size: 9px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 600;
  color: #fff;
  background: rgba(10, 132, 255, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.35);
  padding: 3px 7px;
  border-radius: 999px;
  backdrop-filter: blur(8px);
}

.guide-box {
  position: absolute;
  z-index: 39;
  pointer-events: none;
  border: 1px dashed rgba(10, 132, 255, 0.7);
  border-radius: 16px;
}

.gaze:hover {
  background: rgba(255, 255, 255, 0.16);
}

.gaze-scale:hover {
  transform: scale(1.03);
}

.type-display {
  font-weight: 200;
  letter-spacing: -0.04em;
  line-height: 1.05;
}

.type-meta {
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-fg-tertiary);
  font-weight: 500;
}

.mono {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

.quiet-scroll {
  overflow: auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
}

.quiet-scroll::-webkit-scrollbar {
  width: 8px;
}

.quiet-scroll::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999px;
}

@media (prefers-reduced-motion: reduce) {
  .env-photo,
  .env-aurora,
  .orb-sphere,
  .ember-row.on::before {
    animation: none !important;
  }
  * {
    transition-duration: 0.01ms !important;
  }
}

@media (max-width: 520px) {
  .scene {
    padding: 10px 10px 92px;
  }
  .stage {
    width: 100%;
    height: 100%;
    max-height: none;
    max-width: 100%;
    aspect-ratio: auto;
    margin: 0;
    overflow: hidden;
  }
  .leading-ornament { display: none; }
  .settings-orb { right: 14px; left: auto; }
  .music-widget {
    right: 8px;
    bottom: 86px;
    width: 148px;
  }
}

:root { --ease-spring: cubic-bezier(0.22, 1.2, 0.36, 1); }

.main-window {
  background:
    linear-gradient(180deg, rgba(255,255,255,0.12) 0%, rgba(14,16,22,0.18) 48%, rgba(8,10,16,0.22) 100%);
  border: 1px solid rgba(255,255,255,0.22);
  border-radius: var(--radius-window);
  box-shadow: var(--shadow-window);
  min-width: 0;
  max-width: 100%;
}
.main-window.tucked { transform: translateY(-6%) scale(0.92); transition: transform 480ms var(--ease-spring); }
.main-window.work { background: rgba(10,12,16,0.82); }
.main-window.work .window-body { padding: 8px 8px 12px; }
.window-body { min-width: 0; max-width: 100%; padding: 18px 14px 28px; }

.window-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  height: 18px;
  bottom: -18px;
  background: transparent;
}
.window-grip {
  width: 48px;
  height: 5px;
  border-radius: 999px;
  background: rgba(255,255,255,0.45);
}
.win-close {
  width: 12px;
  height: 12px;
  border-radius: 999px;
  border: 0;
  background: rgba(255,255,255,0.72);
  box-shadow: 0 1px 4px rgba(0,0,0,0.35);
  padding: 0;
}
.win-x {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 8;
  width: 36px;
  height: 36px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.28);
  background: rgba(18,20,26,0.72);
  color: #fff;
  font-size: 22px;
  font-weight: 300;
  line-height: 1;
  display: grid;
  place-items: center;
  padding: 0 0 2px;
}
.main-window:has(.win-x) .window-body { padding-top: 48px; }

.card-view {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
}
.card-view-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 0 48px 10px 2px;
}
.card-view-thread {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-right: 4px;
}
.card-view.slide-left { animation: card-slide-left 160ms var(--ease-out); }
.card-view.slide-right { animation: card-slide-right 160ms var(--ease-out); }
@keyframes card-slide-left {
  from { opacity: 1; transform: translateX(0); }
  to { opacity: 0; transform: translateX(-28px); }
}
@keyframes card-slide-right {
  from { opacity: 1; transform: translateX(0); }
  to { opacity: 0; transform: translateX(28px); }
}

.dock { bottom: 10px; }

.prompt-orb { width: 64px; height: 64px; }
.orb-sphere { width: 64px; height: 64px; }
.prompt-orb::after {
  content: "";
  position: absolute;
  inset: -8px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.28);
  animation: orb-ring 3.2s ease-out infinite;
  pointer-events: none;
}
@keyframes orb-ring {
  0% { transform: scale(0.86); opacity: 0.55; }
  100% { transform: scale(1.18); opacity: 0; }
}

.alert-dim {
  position: absolute;
  inset: 0;
  z-index: 22;
  border: 0;
  background: transparent;
}
.alert-card {
  position: absolute;
  z-index: 24;
  left: 0;
  top: 0;
  width: 268px;
  height: 292px;
  padding: 0;
  border-radius: 32px;
  background: rgba(36,36,40,0.62);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border: 1px solid rgba(255,255,255,0.2);
  box-shadow: 0 18px 60px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.22);
  overflow: hidden;
  animation: alert-in 480ms var(--ease-spring) both;
  display: grid;
  grid-template-rows: auto minmax(0,1fr) auto;
}
@keyframes alert-in { from { opacity: 0; } to { opacity: 1; } }
.alert-grip {
  height: 18px;
  display: grid;
  place-items: center;
  cursor: grab;
  touch-action: none;
}
.alert-grip::after {
  content: "";
  width: 36px;
  height: 4px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.32);
}
.alert-tabs {
  display: flex;
  gap: 0;
  padding: 0 12px 0;
}
.alert-tab {
  flex: 1;
  height: 28px;
  border: 0;
  background: transparent;
  color: rgba(255,255,255,0.55);
  font-size: 10px;
  letter-spacing: 0;
  padding: 0 2px;
}
.alert-tab.on { color: #fff; box-shadow: inset 0 -2px 0 #fff; }
.alert-body {
  padding: 6px 0 0;
  min-height: 0;
  overflow-y: auto;
  scrollbar-width: none;
}
.alert-body::-webkit-scrollbar { display: none; }
.alert-cancel {
  height: 44px;
  border: 0;
  border-top: 1px solid rgba(255,255,255,0.1);
  background: transparent;
  color: #6ea8ff;
  font-size: 16px;
}
.alert-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 36px;
  padding: 0 16px;
  border: 0;
  background: transparent;
  color: #fff;
  font-size: 13px;
}
.alert-title { margin: 16px 16px 4px; font-size: 20px; font-weight: 600; }
.alert-desc { margin: 0 16px 12px; font-size: 13px; color: rgba(255,255,255,0.6); }
.alert-action {
  margin: 8px 16px;
  height: 36px;
  border: 0;
  border-radius: 12px;
  background: rgba(255,255,255,0.14);
  color: #fff;
  font-weight: 600;
}
.alert-menu { padding-bottom: 6px; }
.room-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  padding: 12px 12px 8px;
}
.app-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  border: 0;
  background: transparent;
  color: #fff;
  font-size: 10px;
}
.app-icon svg {
  width: 36px;
  height: 36px;
  padding: 8px;
  border-radius: 10px;
  background: rgba(255,255,255,0.12);
}

.tier-band { position: relative; margin: 4px 8px 6px; padding: 0 6px 6px; border-radius: 14px; }
.tier-band.pro { background: rgba(220,38,38,0.2); outline: 1.5px solid rgba(220,38,38,0.7); }
.tier-band.elite { background: rgba(245,224,0,0.16); outline: 1.5px solid rgba(245,224,0,0.7); }
.tier-kicker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.tier-band.pro .tier-kicker { color: #fff; background: rgba(220,38,38,0.28); margin: 0 -6px 6px; padding: 6px 12px; border-radius: 14px 14px 0 0; }
.tier-band.elite .tier-kicker { color: #fff; background: rgba(255,255,255,0.12); margin: 0 -6px 6px; padding: 6px 12px; border-radius: 14px 14px 0 0; }
.model-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; }
.model-chip {
  height: 32px;
  border: 1px solid color-mix(in srgb, var(--chip-accent, #fff) 22%, transparent);
  border-radius: 10px;
  background: rgba(255,255,255,0.06);
  color: var(--chip-accent, #fff);
  font-size: 11px;
  font-weight: 600;
  font-family: var(--font-sans);
  box-shadow: none;
  transition:
    background 320ms var(--ease-out),
    box-shadow 320ms var(--ease-out),
    color 320ms var(--ease-out),
    border-color 320ms var(--ease-out),
    opacity 320ms var(--ease-out);
}
.model-chip.on {
  color: #fff;
  background: color-mix(in srgb, var(--chip-accent, #fff) 48%, transparent);
  border-color: color-mix(in srgb, var(--chip-accent, #fff) 70%, #fff);
  box-shadow: 0 0 16px color-mix(in srgb, var(--chip-accent, #fff) 42%, transparent);
}
.model-chip.dying {
  opacity: 0;
  box-shadow: none;
  background: rgba(255,255,255,0.06);
}
.tier-lock {
  position: absolute; inset: 0; border: 0; border-radius: inherit;
  background: rgba(8,10,16,0.55); color: #fff; display: grid; place-items: center;
}
.tier-band.pro.locked .tier-lock { background: rgba(70,12,16,0.62); color: #fecaca; }
.tier-band.elite.locked .tier-lock { background: rgba(12,14,20,0.62); color: #fff; }
.cat-row { padding: 0 16px; min-height: 28px; }
.seg {
  display: flex; gap: 2px; padding: 2px; border-radius: 10px; background: rgba(255,255,255,0.08);
}
.seg button {
  width: 28px; height: 24px; border: 0; border-radius: 8px; background: transparent;
  color: rgba(255,255,255,0.7); font-size: 12px; font-weight: 650;
}
.seg button.on { background: rgba(255,255,255,0.2); color: #fff; }

.card-bloom {
  position: absolute;
  top: -36px;
  left: -36px;
  width: 120px;
  height: 120px;
  border-radius: 60px;
  background: var(--card-accent, #fff);
  opacity: 0.16;
  pointer-events: none;
  filter: blur(8px);
}
.card-head { display: flex; align-items: flex-start; margin-bottom: 8px; flex-shrink: 0; }
.card-name {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.2;
  color: #f4f6fa;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 8px 20px rgba(0,0,0,0.55);
}
.card-well {
  flex: 1;
  min-height: 0;
  border-radius: 12px;
  background: rgba(0,0,0,0.22);
  border: 1px solid rgba(255,255,255,0.08);
  padding: 8px 8px 10px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 6px;
  overflow: hidden;
}
.card-blurb {
  margin: 0;
  font-size: 11px;
  line-height: 1.35;
  color: rgba(255,255,255,0.72);
  text-shadow: 0 1px 2px rgba(0,0,0,0.8);
}
.card-mini {
  font-size: 11px;
  line-height: 1.3;
  padding: 6px 7px;
  border-radius: 10px;
  margin: 0;
  background: rgba(255,255,255,0.08);
  color: #fff;
}
.card-mini.you { align-self: flex-end; background: color-mix(in srgb, var(--card-accent, #0a84ff) 38%, transparent); }
.card-view-title { font-size: 22px; font-weight: 500; letter-spacing: -0.03em; margin: 0; color: inherit; }
.os-switch {
  width: 42px;
  height: 24px;
  border-radius: 999px;
  border: 0;
  background: rgba(255,255,255,0.2);
  position: relative;
  flex-shrink: 0;
  transition: background 280ms var(--ease-out);
}
.os-switch::after {
  content: "";
  position: absolute;
  top: 2px;
  left: 2px;
  width: 20px;
  height: 20px;
  border-radius: 999px;
  background: #fff;
  box-shadow: 0 1px 4px rgba(0,0,0,0.35);
  transition: transform 280ms var(--ease-out);
}
.os-switch.on {
  background: #30d158;
}
.os-switch.on::after {
  transform: translateX(18px);
}
.empty-line { color: rgba(255,255,255,0.7); font-size: 14px; }

@keyframes rearrange-glow {
  0%, 100% { filter: brightness(1.08) saturate(1.15); }
  50% { filter: brightness(1.22) saturate(1.35); }
}
.card-aura {
  position: absolute; inset: -12px; border-radius: 26px; pointer-events: none; z-index: -1;
  box-shadow: 0 0 18px var(--card-accent, #fff), 0 0 40px color-mix(in srgb, var(--card-accent, #fff) 55%, transparent);
  animation: aura-pulse 1.35s ease-in-out infinite;
}
@keyframes aura-pulse {
  0%, 100% { opacity: 0.55; transform: scale(0.98); }
  50% { opacity: 1; transform: scale(1.04); }
}

.live-fx, .live-caustic, .live-mist, .env-aurora {
  position: absolute; inset: -10%; pointer-events: none; z-index: 1;
}
.live-aurora, .env-aurora {
  mix-blend-mode: screen; opacity: 0.45;
  background:
    radial-gradient(42% 28% at 28% 18%, rgba(80,255,180,0.45), transparent 70%),
    radial-gradient(38% 26% at 72% 22%, rgba(90,140,255,0.35), transparent 70%);
  animation: aurora 10s ease-in-out infinite alternate;
}
.live-caustic {
  mix-blend-mode: overlay; opacity: 0.4;
  background:
    radial-gradient(20% 12% at 20% 80%, rgba(180,230,255,0.5), transparent 70%),
    linear-gradient(180deg, transparent 55%, rgba(30,80,120,0.28) 100%);
  animation: tide 8s ease-in-out infinite alternate;
}
.live-mist {
  background: radial-gradient(50% 40% at 40% 70%, rgba(255,255,255,0.18), transparent 70%);
  animation: mist 14s ease-in-out infinite alternate;
  mix-blend-mode: screen;
}
.live-fx.live-drift {
  background: linear-gradient(115deg, transparent 30%, rgba(255,255,255,0.08) 48%, transparent 62%);
  animation: drift-shine 16s linear infinite;
}
@keyframes mist {
  from { transform: translate3d(-4%,2%,0) scale(1); opacity: 0.25; }
  to { transform: translate3d(6%,-3%,0) scale(1.12); opacity: 0.5; }
}
@keyframes drift-shine {
  from { transform: translateX(-20%); }
  to { transform: translateX(20%); }
}

.float-root {
  position: absolute; inset: 0; z-index: 18; pointer-events: none; opacity: 0;
  transition: opacity 280ms var(--ease-out);
}
.float-root.open { pointer-events: auto; opacity: 1; }
.sheet-scrim {
  position: absolute; inset: 0; border: 0; background: rgba(6,8,12,0.28);
}
.float-window {
  position: absolute; left: 50%; top: 46%; transform: translate(-50%,-50%);
  width: min(320px, calc(100% - 24px)); max-height: 72%;
  border-radius: 22px;
  background: rgba(18,20,28,0.78);
  border: 1px solid rgba(255,255,255,0.18);
  overflow: hidden;
  display: flex; flex-direction: column;
}
.float-head {
  display: flex; align-items: center; gap: 8px; padding: 10px 12px 8px;
}
.float-title { font-size: 15px; font-weight: 500; }
.sheet-body { min-height: 0; overflow: auto; padding: 0 8px 12px; }
.list-row {
  display: flex; align-items: center; gap: 10px; width: 100%;
  padding: 8px; border: 0; border-radius: 12px;
  background: transparent; color: #fff; text-align: left;
}
.list-thumb { width: 36px; height: 36px; border-radius: 8px; object-fit: cover; }
.list-kind {
  width: 28px; height: 28px; border-radius: 8px;
  background: rgba(255,255,255,0.1); display: grid; place-items: center; font-size: 11px;
}
.list-main { display: flex; flex-direction: column; min-width: 0; }
.list-sub { font-size: 11px; color: rgba(255,255,255,0.5); }

.chip-row { display: flex; gap: 8px; padding: 0 4px 8px; }
.chip {
  height: 28px; padding: 0 12px; border: 0; border-radius: 999px;
  background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.7); font-size: 12px;
}
.chip.on { background: rgba(255,255,255,0.2); color: #fff; }
.dots { display: flex; gap: 5px; justify-content: center; padding: 4px 0 8px; }
.dots span { width: 6px; height: 6px; border-radius: 999px; background: rgba(255,255,255,0.3); }
.dots span.on { width: 14px; background: rgba(255,255,255,0.9); }
.theme-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.theme-tile {
  position: relative; padding: 0; border: 0; border-radius: 16px; overflow: hidden; background: #111;
}
.theme-tile img, .theme-tile video { width: 100%; aspect-ratio: 9/16; object-fit: cover; display: block; }
.theme-tile-name {
  position: absolute; left: 8px; bottom: 8px; color: #fff; font-size: 12px; font-weight: 600;
  text-shadow: 0 1px 4px #000;
}
.live-badge {
  position: absolute; top: 8px; right: 8px; font-size: 9px; letter-spacing: 0.08em;
  text-transform: uppercase; padding: 2px 6px; border-radius: 999px; background: rgba(0,0,0,0.5); color: #fff;
}
.theme-hero-img { width: 100%; height: 180px; object-fit: cover; border-radius: 14px; }
.theme-listen { position: absolute; left: 8px; top: 8px; border: 0; background: rgba(0,0,0,0.45); color: #fff; border-radius: 999px; width: 28px; height: 28px; }
.gate {
  margin: 8px; height: 40px; border: 0; border-radius: 12px;
  background: rgba(255,255,255,0.12); color: #fff;
}
.text-back { border: 0; background: transparent; color: #6ea8ff; padding: 8px; }
.sheet-kicker { font-size: 18px; font-weight: 600; margin: 8px 4px; }
.imagine-search {
  width: 100%; height: 34px; border: 0; border-radius: 12px; padding: 0 12px; margin-bottom: 8px;
  background: rgba(255,255,255,0.1); color: #fff; font-size: 13px;
}

.imagine-wrap {
  display: flex; flex-direction: column; position: relative; min-height: 0; height: 100%;
  margin: -8px -8px -12px;
}
.imagine-tabs { display: flex; justify-content: center; gap: 18px; padding: 2px 0 8px; }
.imagine-tabs button {
  border: 0; background: transparent; color: rgba(255,255,255,0.45);
  font-size: 15px; font-weight: 650; padding: 4px 0;
}
.imagine-tabs button.on { color: #fff; box-shadow: inset 0 -2px 0 #fff; }
.imagine-masonry {
  columns: 2; column-gap: 3px; flex: 1; min-height: 0; overflow: auto;
  padding: 0 3px 64px; scrollbar-width: none;
}
.imagine-tile {
  break-inside: avoid; margin: 0 0 3px; padding: 0; border: 0; background: #111;
  position: relative; width: 100%; border-radius: 8px; overflow: hidden;
}
.imagine-tile img { width: 100%; display: block; object-fit: cover; }
.imagine-composer {
  position: absolute; left: 10px; right: 10px; bottom: 10px;
  display: flex; align-items: center; gap: 8px; height: 48px;
  padding: 4px 4px 4px 16px; border-radius: 24px;
  background: rgba(22,24,30,0.82);
  border: 1px solid rgba(255,255,255,0.16);
  box-shadow: 0 12px 32px rgba(0,0,0,0.35);
}
.imagine-composer input {
  flex: 1; background: transparent; border: 0; color: #fff; outline: none; font-size: 15px;
}
.imagine-exploder { position: absolute; inset: 0; z-index: 8; }
.imagine-frame {
  position: absolute; inset: 8px 8px 16px; margin: 0; border-radius: 16px; overflow: hidden;
  background: #0a0c10; box-shadow: 0 24px 60px rgba(0,0,0,0.5);
  display: flex; flex-direction: column;
}
.imagine-frame img { width: 100%; flex: 1; object-fit: contain; background: #000; }
.imagine-frame figcaption { padding: 10px 14px 14px; font-size: 13px; color: rgba(255,255,255,0.78); }
.imagine-frame .win-close { position: absolute; top: 10px; left: 10px; z-index: 2; }
.play-mark {
  position: absolute; left: 8px; bottom: 8px; width: 18px; height: 18px; border-radius: 999px;
  background: rgba(0,0,0,0.45); border: 1px solid rgba(255,255,255,0.4);
}
.play-mark::after {
  content: ""; position: absolute; left: 7px; top: 5px;
  border-style: solid; border-width: 4px 0 4px 7px;
  border-color: transparent transparent transparent #fff;
}

.plan-stack { display: flex; flex-direction: column; gap: 8px; }
.plan-card {
  position: relative; display: flex; flex-direction: column; gap: 8px; width: 100%;
  padding: 12px 14px; border-radius: 16px;
  border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.05);
  color: #fff; text-align: left;
}
.plan-card.hot { border-color: rgba(255,255,255,0.32); background: rgba(255,255,255,0.09); }
.plan-card.on { border-color: rgba(255,255,255,0.4); }
.plan-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
.plan-name { font-size: 11px; font-weight: 650; letter-spacing: 0.12em; text-transform: uppercase; margin: 0; }
.plan-price { font-size: 20px; font-weight: 500; letter-spacing: -0.03em; margin: 2px 0 0; }
.plan-price span { font-size: 11px; color: rgba(255,255,255,0.5); }
.plan-badge { font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; padding: 3px 7px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.28); }
.plan-features { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: rgba(255,255,255,0.78); }
.plan-cta {
  height: 32px; border: 0; border-radius: 10px; background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.72); font-size: 11px; font-weight: 650; letter-spacing: 0.06em; text-transform: uppercase;
}
.plan-cta.lit { background: #eef2f8; color: #0a0c11; }

.consensus-lip {
  position: absolute; left: 50%; bottom: 86px; transform: translateX(-50%);
  width: min(240px, calc(100% - 96px)); height: 26px;
  display: flex; align-items: center; justify-content: center; gap: 8px;
  border: 0; border-radius: 999px;
  background: rgba(22,24,32,0.55); color: #fff; font-size: 11px; z-index: 13;
}
.consensus-mark {
  width: 7px; height: 7px; border-radius: 999px; background: var(--color-accent);
  box-shadow: 0 0 8px rgba(10,132,255,0.7);
}
.consensus-tease { opacity: 0.8; }
.consensus-root { position: absolute; inset: 0; z-index: 20; }
.consensus-map {
  position: absolute; left: 50%; top: 46%; transform: translate(-50%,-50%);
  width: min(300px, calc(100% - 24px)); padding: 14px; border-radius: 20px;
  background: rgba(18,20,28,0.78); border: 1px solid rgba(255,255,255,0.18);
}
.consensus-head { font-size: 13px; margin-bottom: 8px; }
.consensus-node { font-size: 12px; padding: 6px 0; color: var(--node-accent, #fff); }

.icon-btn {
  width: 32px; height: 32px; border: 0; border-radius: 10px;
  background: rgba(255,255,255,0.1); color: #fff; display: grid; place-items: center;
}
.bubble {
  padding: 8px 10px; border-radius: 14px; background: rgba(255,255,255,0.08); font-size: 14px;
}
.bubble.you { background: rgba(10,132,255,0.28); }

.ctx-menu {
  position: fixed; z-index: 80; min-width: 168px; padding: 6px; border-radius: 16px;
  background: rgba(36,36,40,0.72); border: 1px solid rgba(255,255,255,0.22);
  box-shadow: 0 18px 40px rgba(0,0,0,0.45);
}
.ctx-menu button {
  display: block; width: 100%; text-align: left; border: 0; background: transparent;
  color: #fff; font-size: 14px; padding: 11px 12px; border-radius: 12px;
}
.ctx-menu button.danger { color: #ff6b6b; }

html, body, #app, .app-root { min-height: 100dvh; height: 100%; }

